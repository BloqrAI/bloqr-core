{
  "extends": "../../deno.base.json",
  "name": "@bloqr/compiler-core",
  "version": "1.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./orchestration": "./src/orchestration/index.ts",
    "./console": "./src/console/index.ts",
    "./cli": "./src/orchestration/cli.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "CHANGELOG.md"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.bench.ts"
    ]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts",
    "interactive": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts --interactive",
    "compile": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts --compile",
    "compile:yaml": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts -c compiler-config.yaml",
    "compile:toml": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts -c compiler-config.toml",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run --watch src/mod.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net src/",
    "test:coverage": "deno test --allow-read --allow-write --allow-env --allow-net --coverage=coverage src/",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/",
    "version": "deno run --allow-read --allow-env src/mod.ts --version",
    "generate:types": "deno run --allow-read --allow-write --no-npm generate-types.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "@std/path": "jsr:@std/path@^1.1.5",
    "zod": "jsr:@zod/zod@^4.4.3",
    "node:fs": "node:fs",
    "node:fs/promises": "node:fs/promises",
    "node:path": "node:path",
    "node:crypto": "node:crypto",
    "yaml": "npm:yaml@^2.9.0",
    "@iarna/toml": "npm:@iarna/toml@^2.2.5",
    "chalk": "npm:chalk@^5.6.2",
    "cli-table3": "npm:cli-table3@^0.6.5",
    "ora": "npm:ora@^9.4.1",
    "figlet": "npm:figlet@^1.11.4",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.5.2"
  },
  "allowScripts": ["npm:core-js@3.47.0"],
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "require-await"]
    }
  }
}
