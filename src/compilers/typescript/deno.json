{
  "extends": "../../../deno.base.json",
  "name": "@bloqr/compiler-core",
  "version": "1.3.0",
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./orchestration": "./src/orchestration/index.ts",
    "./console": "./src/console/index.ts",
    "./cli": "./src/orchestration/cli.ts",
    "./bun": "./src/mod.bun.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "CHANGELOG.md"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.bench.ts"
    ]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts",
    "interactive": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts --interactive",
    "compile": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts --compile",
    "benchmark": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run src/mod.ts --benchmark",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run --watch src/mod.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run src/",
    "test:coverage": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --coverage=coverage src/",
    "check": "deno check src/mod.ts src/mod.bun.ts",
    "lint": "deno lint src/",
    "lint:docs": "deno run --allow-read --allow-run scripts/check-symbol-docs.ts",
    "fmt": "deno fmt src/",
    "version": "deno run --allow-read --allow-env src/mod.ts --version",
    "version:sync": "deno run --allow-read --allow-write scripts/sync-version.ts",
    "generate:types": "deno run --allow-read --allow-write --no-npm generate-types.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
    "zod": "jsr:@zod/zod@^4.4.3",
    "node:fs": "node:fs",
    "node:fs/promises": "node:fs/promises",
    "node:path": "node:path",
    "node:crypto": "node:crypto",
    "node:url": "node:url",
    "node:child_process": "node:child_process",
    "node:os": "node:os",
    // ora: no JSR-native terminal-spinner library with comparable maturity/adoption exists
    // (audited for #294; only near-equivalents found were unmaintained/zero-dependent forks).
    "ora": "npm:ora@^9.4.1",
    // figlet: no JSR-native ASCII-art banner library exists (audited for #294).
    "figlet": "npm:figlet@^1.11.4",
    // @inquirer/prompts: @cliffy/prompt (JSR) was evaluated as a candidate but has a materially
    // different API (class-based `Select.prompt({ options })` vs. function-based `select({ choices })`)
    // and this module's interactive flows have no automated test coverage to verify behavioral parity
    // against a real TTY. Left in place pending a dedicated follow-up with manual/e2e verification
    // (audited for #294).
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.6.0"
  },
  "allowScripts": ["npm:core-js@3.47.0"],
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "require-await"]
    }
  }
}
