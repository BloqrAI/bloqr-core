<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bloqr.Compiler.Dotnet</AssemblyName>
    <PackageId>Bloqr.Compiler.Dotnet</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Bloqr</Authors>
    <Company>Bloqr</Company>
    <AssemblyTitle>AdGuard Filter Compiler</AssemblyTitle>
    <Description>C# library for compiling AdGuard filter rules using @bloqr/compiler-core (via Deno)</Description>
    <Copyright>Copyright 2024</Copyright>
    <RootNamespace>Bloqr.Compiler.Dotnet</RootNamespace>
    <Version>1.0.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Bloqr.Compiler.Dotnet.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/BloqrAI/bloqr-core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>.NET wrapper for @bloqr/compiler-core, shelled out to via Deno</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\common\dotnet\src\Bloqr.Compiler.Abstractions\Bloqr.Compiler.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\common\dotnet\src\Bloqr.Compiler.Core\Bloqr.Compiler.Core.csproj" />
  </ItemGroup>

</Project>
