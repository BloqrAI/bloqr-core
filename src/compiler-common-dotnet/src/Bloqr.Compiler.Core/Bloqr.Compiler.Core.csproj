<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bloqr.Compiler.Core</AssemblyName>
    <PackageId>Bloqr.Compiler.Core</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Bloqr</Authors>
    <Company>Bloqr</Company>
    <AssemblyTitle>Bloqr Compiler Core</AssemblyTitle>
    <Description>Common .NET library for Bloqr's filter-rules compilers and Dashboard: multi-format (JSON/YAML/TOML) configuration reading and validation, chunked parallel compilation support, file locking, the compilation event pipeline, the plugin system, and shared structured JSON logging. Extracted from RulesCompiler so it can be shared across compiler-specific projects.</Description>
    <Copyright>Copyright 2024</Copyright>
    <RootNamespace>Bloqr.Compiler.Core</RootNamespace>
    <Version>1.0.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Bloqr.Compiler.Core.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/BloqrAI/bloqr-core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/BloqrAI/bloqr-core</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bloqr.Compiler.Abstractions\Bloqr.Compiler.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\schemas\compiler-config.schema.json">
      <LogicalName>compiler-config.schema.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
