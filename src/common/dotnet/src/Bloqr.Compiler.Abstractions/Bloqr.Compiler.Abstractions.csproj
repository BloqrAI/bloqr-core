<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bloqr.Compiler.Abstractions</AssemblyName>
    <PackageId>Bloqr.Compiler.Abstractions</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Bloqr</Authors>
    <Company>Bloqr</Company>
    <AssemblyTitle>Bloqr Compiler Abstractions</AssemblyTitle>
    <Description>Shared interfaces and event-argument contracts for Bloqr's filter-rules compilers and Dashboard: compilation pipeline, event dispatch, plugin system, chunking, file locking, and hash verification.</Description>
    <Copyright>Copyright 2024</Copyright>
    <RootNamespace>Bloqr.Compiler.Abstractions</RootNamespace>
    <Version>1.0.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Bloqr.Compiler.Abstractions.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/BloqrAI/bloqr-core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/BloqrAI/bloqr-core</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
